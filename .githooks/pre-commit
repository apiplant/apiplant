#!/usr/bin/env bash
# Pre-commit hook: keep the READMEs pinned to the workspace version, and rebuild
# whatever generated assets the staged changes invalidate.
#
# Enable in a fresh clone with:  git config core.hooksPath .githooks
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

version=$(sed -n '/^\[workspace\.package\]/,/^\[/p' Cargo.toml \
  | sed -n 's/^version *= *"\([^"]*\)".*/\1/p' | head -n 1)
if [ -z "$version" ]; then
  echo "pre-commit: could not read version from Cargo.toml" >&2
  exit 1
fi
minor=${version%.*}

# ---------------------------------------------------------------- version sync
for f in README.md docs/README.md; do
  [ -f "$f" ] || continue
  before=$(cat "$f")
  sed -i -E \
    -e "s/apiplant-v[0-9]+\.[0-9]+\.[0-9]+/apiplant-v$version/g" \
    -e "s/apiplant:[0-9]+\.[0-9]+(\.[0-9]+)?/apiplant:$version/g" \
    -e "s/\`[0-9]+\.[0-9]+\.[0-9]+\`/\`$version\`/g" \
    -e "s/\`[0-9]+\.[0-9]+\`/\`$minor\`/g" \
    -e "s/(# or +):[0-9]+\.[0-9]+/\1:$minor/g" \
    "$f"
  if [ "$before" != "$(cat "$f")" ]; then
    echo "pre-commit: updated version in $f -> $version"
    git add "$f"
  fi
done

# The marketplace advertises the skill at the version of the server it documents.
if [ -f .claude-plugin/marketplace.json ]; then
  before=$(cat .claude-plugin/marketplace.json)
  sed -i -E "s/(\"version\": *\")[0-9]+\.[0-9]+\.[0-9]+(\")/\1$version\2/" \
    .claude-plugin/marketplace.json
  if [ "$before" != "$(cat .claude-plugin/marketplace.json)" ]; then
    echo "pre-commit: updated version in .claude-plugin/marketplace.json -> $version"
    git add .claude-plugin/marketplace.json
  fi
fi

# --------------------------------------------------------------------- rebuilds
staged=$(git diff --cached --name-only --diff-filter=ACMR)

changed() {
  echo "$staged" | grep -qE "$1"
}

# Keep the workspace formatted whenever Rust sources are staged. Ask rustfmt
# which files it would rewrite first, then stage exactly those — never the
# caller's unrelated unstaged edits.
if changed '\.rs$'; then
  echo "pre-commit: running cargo fmt"
  fmt_targets=$(cargo fmt --all -- --check 2>&1 \
    | sed -n 's/^Diff in \([^:]*\):.*/\1/p' | sort -u || true)
  if [ -n "$fmt_targets" ]; then
    cargo fmt --all
    echo "pre-commit: staged formatting changes"
    # shellcheck disable=SC2086
    git add $fmt_targets
  fi
fi

# Anything staged under the generated asset trees is a build output, not input.
if changed '^studio/(src|public|index\.html|package\.json|vite\.config\.ts|tsconfig\.json)'; then
  echo "pre-commit: rebuilding studio"
  (cd studio && pnpm install --frozen-lockfile --prefer-offline >/dev/null && pnpm build)
  git add crates/apiplant-assets/assets/studio
fi

if changed '^admin/(src|index\.html|package\.json|vite\.config\.ts|tsconfig\.json)'; then
  echo "pre-commit: rebuilding admin"
  (cd admin && pnpm install --frozen-lockfile --prefer-offline >/dev/null && pnpm build)
  git add crates/apiplant-assets/assets/admin
fi

# The npm package's sources live in the js crate's assets; `pnpm sync` copies
# them into typescript/ (gitignored) so the type check runs against the truth.
if changed '^(typescript/|crates/apiplant-js/assets/)'; then
  echo "pre-commit: syncing and checking typescript"
  (cd typescript && pnpm install --frozen-lockfile --prefer-offline >/dev/null && pnpm sync && pnpm check)
fi

# skills/ is assembled from docs/ and examples/ and committed, so it can be
# copied into ~/.claude/skills without a build step. It is output: regenerate
# it here rather than trusting anyone to remember. The script refuses to run if
# docs/ and its reference table have drifted apart.
if changed '^(docs/|examples/|scripts/generate-skill\.py)'; then
  echo "pre-commit: regenerating the apiplant skill"
  ./scripts/generate-skill.py >/dev/null
  git add skills
fi

# The framework website indexes every docs/*.md page. Keep the committed
# sitemap fresh whenever docs or the sitemap generator change.
if changed '^(docs/|website/scripts/generate-sitemap\.mjs|website/package\.json)'; then
  echo "pre-commit: regenerating the framework website sitemap"
  (cd website && pnpm run sitemap)
  git add website/public/sitemap.xml
fi
