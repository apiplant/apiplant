#
# Generated from packaging/aur/PKGBUILD in apiplant/apiplant by the release
# workflow, which fills in the version and checksums, regenerates .SRCINFO, and
# pushes both here. Changes belong in the source repository: the next release
# overwrites this file.
pkgname=apiplant-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Point it at an app directory and it serves an API"
arch=('x86_64' 'aarch64')
url="https://github.com/apiplant/apiplant"
license=('MIT' 'Apache-2.0')
provides=('apiplant')
conflicts=('apiplant')
# One archive per architecture, each holding the binary and the README. The
# release builds both natively, so neither is emulated.
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/apiplant-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/apiplant-v$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@SHA_LINUX_X86_64@')
sha256sums_aarch64=('@SHA_LINUX_ARM64@')
# The release profile already strips symbols, and makepkg's strip pass on an
# LTO'd binary buys nothing.
options=('!strip' '!debug')

package() {
  local triple
  case "$CARCH" in
    x86_64) triple=x86_64-unknown-linux-gnu ;;
    aarch64) triple=aarch64-unknown-linux-gnu ;;
    *) echo "unsupported architecture $CARCH" >&2; return 1 ;;
  esac

  local src="$srcdir/apiplant-v$pkgver-$triple"
  install -Dm755 "$src/apiplant" "$pkgdir/usr/bin/apiplant"
  install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
