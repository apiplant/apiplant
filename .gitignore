/target
/dist
**/node_modules/
**/*.rs.bk
*.pdb

# Local TLS material and secrets should never be committed.
**/https/*.pem
**/https/*.key
**/https/*.crt

# Compiled function libraries dropped into example apps.
examples/**/functions/*.so
examples/**/functions/*.dylib
examples/**/functions/*.dll

# The JavaScript `apiplant build` writes from a TypeScript function, and the
# ambient types it drops beside it. Generated, like the libraries above.
examples/**/functions/*.js
examples/**/functions/apiplant.d.ts
examples/**/functions/tsconfig.json

# Build state from example function *directories* (a crate or module the author
# owns) — regenerated by `apiplant build`, like the libraries above.
examples/**/functions/**/Cargo.lock
examples/**/functions/**/target/
# A TypeScript function directory is an npm project: its bundle is output, and
# its dependencies are installed. The lockfile is not — that one is committed.
examples/**/functions/**/dist/

# Uploaded files. `[storage] backend = "local"` creates this directory on boot
# and fills it with whatever people upload — never something to commit.
examples/**/storage/
/storage/

# Static admin panels baked into an example by `apiplant admin`.
examples/**/admin

pgdata
.apiplant-build/

# Playwright artefacts from the end-to-end suite.
e2e/test-results/
e2e/playwright-report/

# The npm package's two files live in crates/apiplant-js/assets/, which is what
# the crate embeds and what cargo publishes. `pnpm sync` copies them here for an
# `npm publish`; the copies are output, like a dist/.
typescript/apiplant.js
typescript/apiplant.d.ts

.env
